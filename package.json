{
  "name": "dsh-mail-notify",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：agent 每结束一轮回答，就发一封通知邮件；向用户提问时也会立刻发一封。零依赖，只用 Node 内置模块。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./smtp": "./smtp.mjs",
    "./mime": "./mime.mjs",
    "./imap": "./imap.mjs",
    "./mail": "./mail.mjs",
    "./reply": "./reply.mjs",
    "./workspace": "./workspace.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "smtp.mjs",
    "mime.mjs",
    "imap.mjs",
    "mail.mjs",
    "reply.mjs",
    "workspace.mjs",
    "selftest.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "selftest": "node selftest.mjs",
    "check": "node --check index.mjs && node --check smtp.mjs && node --check mime.mjs && node --check imap.mjs && node --check mail.mjs && node --check reply.mjs && node --check workspace.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
